<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cadastrar Face | Painel</title>
<link rel="stylesheet" href="/style.css">
</head>
<body class="dash-bg" style="--bg: url('<%= bg || '/bg.jpg' %>');">
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-brand"><% if (logo) { %><img src="<%= logo %>" alt="Logo"><% } else { %>Painel<% } %></div>
    <nav class="sidebar-nav">
      <a href="/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
        Dashboard
      </a>
      <a href="/importar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        Importar
      </a>
      <a href="/cadastrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
        Cadastrar Admin
      </a>
      <a href="/cadastrar-face" class="active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        Cadastrar Face
      </a>
      <a href="/pagamentos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        Pagamentos
      </a>
    </nav>
    <div class="sidebar-foot">
      <a href="/logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Sair
      </a>
    </div>
  </aside>
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
  <div class="content">
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle" aria-label="Abrir menu">☰</button>
      <span class="topbar-title">Cadastrar Face</span>
    </header>
    <main>
  <div class="two-col">
    <section class="panel">
      <h2>Cadastrar nova face</h2>
      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>
      <form method="POST" action="/cadastrar-face" enctype="multipart/form-data">
        <label for="name">Nome</label>
        <input type="text" id="name" name="name" required autofocus>
        <label for="description">Descrição</label>
        <textarea id="description" name="description" rows="6" placeholder="Cole aqui as informações do produto..."></textarea>
        <label for="gender">Categoria</label>
        <select id="gender" name="gender">
          <option value="">— Sem categoria —</option>
          <option value="homem">👨 Homem</option>
          <option value="mulher">👩 Mulher</option>
        </select>
        <label for="vehicle">Veículo</label>
        <select id="vehicle" name="vehicle">
          <option value="">— Nenhum —</option>
          <option value="carro">🚗 Carro</option>
          <option value="moto">🏍 Moto/Carro</option>
        </select>
        <label for="platform">Plataforma</label>
        <select id="platform" name="platform">
          <option value="">— Nenhuma —</option>
          <option value="uber">UBER</option>
          <option value="uberx99">Uber X / 99</option>
          <option value="99">99</option>
        </select>
        <label for="foto">Foto do rosto</label>
        <input type="file" id="foto" name="foto" accept="image/*" required>
        <button type="submit" class="btn primary">Cadastrar</button>
      </form>
    </section>

    <section class="panel">
      <h2>Faces cadastradas (<%= faces.length %>)</h2>
      <% if (faces.length === 0) { %>
        <p class="empty">Nenhuma face cadastrada.</p>
      <% } else { %>
        <div class="face-grid">
          <% faces.forEach(f => { %>
          <div class="face-card">
            <img src="/faces/<%= f.photo %>" alt="<%= f.name %>">
            <div class="face-info">
              <strong>#<%= f.id %></strong>
              <span><%= f.name %></span>
              <% if (f.description) { %>
                <span class="desc"><%= f.description %></span>
              <% } %>
              <span class="tags">
                <% if (f.category) { %><span class="tag">📁 <%= f.category %></span><% } %>
                <% if (f.price) { %><span class="tag">R$ <%= Number(f.price).toFixed(2).replace('.', ',') %></span><% } %>
                <% if (f.gender) { %><span class="tag"><%= f.gender %></span><% } %>
                <% if (f.vehicle) { %><span class="tag"><%= f.vehicle %></span><% } %>
                <% if (f.platform) { %><span class="tag"><%= f.platform %></span><% } %>
              </span>
              <div class="platform-btns">
                <% if (f.platform === 'uber' || f.platform === 'uberx99' || !f.platform) { %>
                <form method="POST" action="/faces/<%= f.id %>/vender" onsubmit="return confirm('<%= f.sold_uber ? 'Desmarcar como vendido na UBER? O produto volta a ficar à venda.' : 'Confirmar venda na UBER?' %>')">
                  <input type="hidden" name="platform" value="uber">
                  <input type="hidden" name="value" value="<%= f.sold_uber ? '0' : '1' %>">
                  <button type="submit" class="pbtn <%= f.sold_uber ? 'sold' : 'avail' %>">UBER: <%= f.sold_uber ? 'VENDIDO' : 'À VENDA' %></button>
                </form>
                <% } %>
                <% if (f.platform === '99' || f.platform === 'uberx99' || !f.platform) { %>
                <form method="POST" action="/faces/<%= f.id %>/vender" onsubmit="return confirm('<%= f.sold_99 ? 'Desmarcar como vendido na 99POP? O produto volta a ficar à venda.' : 'Confirmar venda na 99POP?' %>')">
                  <input type="hidden" name="platform" value="99">
                  <input type="hidden" name="value" value="<%= f.sold_99 ? '0' : '1' %>">
                  <button type="submit" class="pbtn <%= f.sold_99 ? 'sold' : 'avail' %>">99POP: <%= f.sold_99 ? 'VENDIDO' : 'À VENDA' %></button>
                </form>
                <% } %>
              </div>
            </div>
            <form method="POST" action="/faces/<%= f.id %>/delete" onsubmit="return confirm('Excluir face <%= f.id %>?')">
              <button type="submit" class="btn danger small">Excluir</button>
            </form>
            <form method="POST" action="/faces/<%= f.id %>/antecedentes" onsubmit="return confirm('Marcar face <%= f.id %> como COM ANTECEDENTES e excluir da loja?')">
              <button type="submit" class="btn warn small">⚠️ Com antecedentes</button>
            </form>
            <a class="btn primary small" href="/faces/<%= f.id %>/editar">✏️ Editar</a>
          </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
  </main>
  </div>
</div>
<script src="/app.js"></script>
</body>
</html>
