<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Editar Face #<%= face.id %> | Painel</title>
<link rel="stylesheet" href="/style.css">
</head>
<body class="dash-bg" style="--bg: url('<%= bg || '/bg.jpg' %>');">
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-brand"><% if (logo) { %><img src="<%= logo %>" alt="Logo"><% } else { %>Painel<% } %></div>
    <nav class="sidebar-nav">
      <a href="/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
        Dashboard
      </a>
      <a href="/importar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        Importar
      </a>
      <a href="/cadastrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
        Cadastrar Admin
      </a>
      <a href="/cadastrar-face" class="active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        Cadastrar Face
      </a>
      <a href="/pagamentos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        Pagamentos
      </a>
    </nav>
    <div class="sidebar-foot">
      <a href="/logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Sair
      </a>
    </div>
  </aside>
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
  <div class="content">
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle" aria-label="Abrir menu">☰</button>
      <span class="topbar-title">Editar Face #<%= face.id %></span>
    </header>
    <main>
  <div class="two-col">
    <section class="panel">
      <h2>Editar produto #<%= face.id %></h2>
      <% if (error) { %>
        <div class="alert error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>
      <form method="POST" action="/faces/<%= face.id %>/editar" enctype="multipart/form-data">
        <label for="name">Nome</label>
        <input type="text" id="name" name="name" value="<%= face.name %>" required>
        <label for="description">Descrição</label>
        <textarea id="description" name="description" rows="6" placeholder="Cole aqui as informações do produto..."><%= face.description || '' %></textarea>
        <label for="gender">Categoria</label>
        <select id="gender" name="gender">
          <option value="">— Sem categoria —</option>
          <option value="homem" <%= face.gender === 'homem' ? 'selected' : '' %>>👨 Homem</option>
          <option value="mulher" <%= face.gender === 'mulher' ? 'selected' : '' %>>👩 Mulher</option>
        </select>
        <label for="vehicle">Veículo</label>
        <select id="vehicle" name="vehicle">
          <option value="">— Nenhum —</option>
          <option value="carro" <%= face.vehicle === 'carro' ? 'selected' : '' %>>🚗 Carro</option>
          <option value="moto" <%= face.vehicle === 'moto' ? 'selected' : '' %>>🏍 Moto/Carro</option>
        </select>
        <label for="platform">Plataforma</label>
        <select id="platform" name="platform">
          <option value="">— Nenhuma —</option>
          <option value="uber" <%= face.platform === 'uber' ? 'selected' : '' %>>UBER</option>
          <option value="uberx99" <%= face.platform === 'uberx99' ? 'selected' : '' %>>Uber X / 99</option>
          <option value="99" <%= face.platform === '99' ? 'selected' : '' %>>99</option>
        </select>
        <label for="foto">Nova foto do rosto (opcional)</label>
        <input type="file" id="foto" name="foto" accept="image/*">
        <p class="hint">Deixe vazio para manter a foto atual e a busca por similaridade.</p>
        <button type="submit" class="btn primary">💾 Salvar alterações</button>
        <a class="btn" href="/cadastrar-face">Voltar</a>
      </form>
    </section>

    <section class="panel">
      <h2>Foto atual</h2>
      <img class="face-preview" src="/faces/<%= face.photo %>" alt="<%= face.name %>">
      <p>
        <span class="tag <%= (face.platform === 'uber' || face.platform === 'uberx99') && !face.sold_uber ? 'ok' : 'warn' %>">UBER: <%= (face.platform === 'uber' || face.platform === 'uberx99') ? (face.sold_uber ? 'vendido' : 'ativo') : '—' %></span>
        <span class="tag <%= (face.platform === '99' || face.platform === 'uberx99') && !face.sold_99 ? 'ok' : 'warn' %>">99: <%= (face.platform === '99' || face.platform === 'uberx99') ? (face.sold_99 ? 'vendido' : 'ativo') : '—' %></span>
      </p>
      <p class="hint">Cadastrado em <%= face.created_at %></p>
    </section>
  </div>
  </main>
  </div>
</div>
<script src="/app.js"></script>
</body>
</html>
