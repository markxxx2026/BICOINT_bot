<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="refresh" content="5">
<title>Dashboard | Painel</title>
<link rel="stylesheet" href="/style.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
</head>
<body class="dash-bg">
<header class="topbar">
  <div class="brand">Painel</div>
  <nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/importar">Importar</a>
    <a href="/cadastrar">Cadastrar Admin</a>
    <a href="/cadastrar-face">Cadastrar Face</a>
    <a href="/pagamentos">Pagamentos</a>
    <a href="/logout">Sair</a>
  </nav>
</header>
<main>
  <div class="cards">
    <div class="card">
      <h2><%= stats.users %></h2>
      <p>Usuários (Start)</p>
    </div>
    <div class="card">
      <h2><%= stats.faces %></h2>
      <p>Produtos Ativos</p>
    </div>
    <div class="card">
      <h2><%= stats.sold %></h2>
      <p>Vendidos</p>
    </div>
    <div class="card">
      <h2>R$ <%= stats.receita.toFixed(2).replace('.', ',') %></h2>
      <p>Receita Total</p>
    </div>
    <div class="card">
      <h2><%= stats.pendentes %></h2>
      <p>Pagamentos Pendentes</p>
    </div>
  </div>

  <div class="charts-row">
    <section class="panel">
      <h2>🥧 Vendas por plataforma</h2>
      <div class="chart-box">
        <canvas id="pieChart"></canvas>
      </div>
    </section>
    <section class="panel">
      <h2>📊 Ganhos por dia (últimos 7 dias)</h2>
      <div class="chart-box">
        <canvas id="barChart"></canvas>
      </div>
    </section>
  </div>

  <section class="panel">
    <h2>Gerar Gift (vale 1 compra)</h2>
    <% if (newGift) { %>
      <div class="alert success">
        🎁 Gift gerado com sucesso! Envie este código para o cliente:<br>
        <strong style="font-size: 1.3rem; letter-spacing: 1px;"><%= newGift %></strong><br>
        O cliente resgata no bot com: <code>/resgatar <%= newGift %></code>
      </div>
    <% } %>
    <form method="POST" action="/gifts/gerar">
      <button type="submit" class="btn primary">🎁 Gerar Gift (vale 1 compra)</button>
    </form>
  </section>

  <section class="panel">
    <h2>Gifts gerados</h2>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Valor</th>
          <th>Status</th>
          <th>Usado por</th>
          <th>Criado em</th>
        </tr>
      </thead>
      <tbody>
        <% gifts.forEach(g => { %>
        <tr>
          <td><code><%= g.code %></code></td>
          <td>R$ <%= g.credits.toFixed(2).replace('.', ',') %></td>
          <td><span class="badge <%= g.status === 'ativo' ? 'ok' : 'warn' %>"><%= g.status %></span></td>
          <td><%= g.used_by || '—' %></td>
          <td><%= g.created_at %></td>
        </tr>
        <% }) %>
        <% if (gifts.length === 0) { %>
        <tr><td colspan="5" class="empty">Nenhum gift gerado ainda.</td></tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <section class="panel">
    <h2>Admins (acesso ao painel)</h2>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Usuário</th>
          <th>Criado em</th>
        </tr>
      </thead>
      <tbody>
        <% adminsList.forEach(a => { %>
        <tr>
          <td><%= a.id %></td>
          <td><%= a.username %></td>
          <td><%= a.created_at %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <section class="panel">
    <h2>Últimos pagamentos (em tempo real)</h2>
    <table>
      <thead>
        <tr>
          <th>Tipo</th>
          <th>Detalhe</th>
          <th>Chat</th>
          <th>Valor</th>
          <th>Status</th>
          <th>Data</th>
        </tr>
      </thead>
      <tbody>
        <% payments.forEach(p => { %>
        <tr>
          <td><%= p.tipo === 'unlock' ? '📸 Foto' : '💰 Recarga' %></td>
          <td><%= p.descricao %></td>
          <td><%= p.chat_id %></td>
          <td>R$ <%= p.amount.toFixed(2).replace('.', ',') %></td>
          <td>
            <% if (p.tipo === 'refill') { %>
              <% if (p.status === 'pago') { %>
                <span class="badge blue">✅ Dinheiro adicionado</span>
              <% } else { %>
                <span class="badge warn">⏳ Pendente</span>
              <% } %>
            <% } else { %>
              <% if (p.status === 'pago') { %>
                <span class="badge vendido">✅ VENDIDO</span>
              <% } else { %>
                <span class="badge warn">⏳ Pendente</span>
              <% } %>
            <% } %>
          </td>
          <td><%= p.created_at %></td>
        </tr>
        <% }) %>
        <% if (payments.length === 0) { %>
        <tr><td colspan="6" class="empty">Nenhum pagamento ainda.</td></tr>
        <% } %>
      </tbody>
    </table>
  </section>
</main>
<script>
(function () {
  var pieLabels = <%- chartPie.labels %>;
  var pieValues = <%- chartPie.values %>;
  var barLabels = <%- chartBar.labels %>;
  var barValues = <%- chartBar.values %>;

  var dark = '#0f172a';
  var border = '#334155';
  var text = '#e2e8f0';
  var muted = '#94a3b8';
  var grid = '#1e293b';

  if (window.Chart) {
    new Chart(document.getElementById('pieChart'), {
      type: 'pie',
      data: {
        labels: pieLabels,
        datasets: [{
          data: pieValues,
          backgroundColor: ['#38bdf8', '#22c55e', '#f59e0b'],
          borderColor: border,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { labels: { color: text } }
        }
      }
    });

    new Chart(document.getElementById('barChart'), {
      type: 'bar',
      data: {
        labels: barLabels,
        datasets: [{
          label: 'Receita (R$)',
          data: barValues,
          backgroundColor: '#38bdf8',
          borderColor: '#0ea5e9',
          borderWidth: 1,
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { ticks: { color: muted }, grid: { color: grid } },
          y: { beginAtZero: true, ticks: { color: muted }, grid: { color: grid } }
        },
        plugins: {
          legend: { labels: { color: text } }
        }
      }
    });
  }
})();
</script>
</body>
</html>
