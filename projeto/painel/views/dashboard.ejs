<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard | Painel</title>
<link rel="stylesheet" href="/style.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
</head>
<body class="dash-bg" style="--bg: url('<%= bg || '/bg.jpg' %>');">
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-brand"><% if (logo) { %><img src="<%= logo %>" alt="Logo"><% } else { %>Painel<% } %></div>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
        Dashboard
      </a>
      <a href="/importar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        Importar
      </a>
      <a href="/cadastrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
        Cadastrar Admin
      </a>
      <a href="/cadastrar-face">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        Cadastrar Face
      </a>
      <a href="/pagamentos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        Pagamentos
      </a>
    </nav>
    <div class="sidebar-foot">
      <a href="/logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Sair
      </a>
    </div>
  </aside>
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
  <div class="content">
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle" aria-label="Abrir menu">☰</button>
      <span class="topbar-title">Dashboard</span>
    </header>
    <main>
  <div class="cards">
    <div class="card">
      <h2><%= stats.users %></h2>
      <p>Usuários (Start)</p>
    </div>
    <div class="card">
      <h2><%= stats.faces %></h2>
      <p>Produtos Ativos</p>
    </div>
    <div class="card">
      <h2><%= stats.sold %></h2>
      <p>Vendidos</p>
    </div>
    <div class="card">
      <h2>R$ <%= stats.receita.toFixed(2).replace('.', ',') %></h2>
      <p>Receita Total</p>
    </div>
    <div class="card">
      <h2><%= stats.pendentes %></h2>
      <p>Pagamentos Pendentes</p>
    </div>
  </div>

  <div class="charts-row">
    <section class="panel">
      <h2>🥧 Vendas por plataforma</h2>
      <div class="chart-box">
        <canvas id="pieChart"></canvas>
      </div>
    </section>
    <section class="panel">
      <h2>📊 Ganhos por dia (últimos 7 dias)</h2>
      <div class="chart-box">
        <canvas id="barChart"></canvas>
      </div>
    </section>
  </div>

  <section class="panel">
    <h2>Gerar Gift (vale 1 compra)</h2>
    <% if (newGift) { %>
      <div class="alert success">
        🎁 Gift gerado com sucesso! Envie este código para o cliente:<br>
        <strong style="font-size: 1.3rem; letter-spacing: 1px;"><%= newGift %></strong><br>
        O cliente resgata no bot com: <code>/resgatar <%= newGift %></code>
      </div>
    <% } %>
    <form method="POST" action="/gifts/gerar">
      <button type="submit" class="btn primary">🎁 Gerar Gift (vale 1 compra)</button>
    </form>
  </section>

  <section class="panel">
    <h2>🖼️ Logo do painel (login e menu)</h2>
    <p class="hint" style="margin-bottom: 12px;">Apenas a marca (logo). Isso <strong>não cadastra produtos</strong>.</p>
    <% if (logoMsg) { %>
      <div class="alert success"><%= logoMsg %></div>
    <% } %>
    <% if (logoError) { %>
      <div class="alert error"><%= logoError %></div>
    <% } %>
    <% if (logo) { %>
      <div class="logo-preview"><img src="<%= logo %>" alt="Logo atual"></div>
    <% } else { %>
      <p class="muted">Nenhuma logo definida. Envie uma imagem abaixo (JPG, PNG ou WEBP).</p>
    <% } %>
    <form method="POST" action="/logo" enctype="multipart/form-data" class="logo-form">
      <input type="file" name="logo" accept="image/jpeg,image/png,image/webp" required>
      <button type="submit" class="btn primary">Salvar logo</button>
    </form>
    <% if (logo) { %>
      <form method="POST" action="/logo/remove" class="logo-form" onsubmit="return confirm('Remover a logo atual?');">
        <button type="submit" class="btn danger">Remover logo</button>
      </form>
    <% } %>
  </section>

  <section class="panel">
    <h2>🖼️ Fundo da Dashboard</h2>
    <p class="hint" style="margin-bottom: 12px;">Apenas a imagem de fundo da Dashboard. Isso <strong>não cadastra produtos</strong>.</p>
    <% if (bgMsg) { %>
      <div class="alert success"><%= bgMsg %></div>
    <% } %>
    <% if (bgError) { %>
      <div class="alert error"><%= bgError %></div>
    <% } %>
    <% if (bg) { %>
      <div class="bg-preview"><img src="<%= bg %>" alt="Fundo atual"></div>
    <% } else { %>
      <p class="muted">Usando o fundo padrão. Envie uma imagem abaixo (JPG, PNG ou WEBP) para personalizar.</p>
    <% } %>
    <form method="POST" action="/bg" enctype="multipart/form-data" class="logo-form">
      <input type="file" name="bg" accept="image/jpeg,image/png,image/webp" required>
      <button type="submit" class="btn primary">Salvar fundo</button>
    </form>
    <% if (bg) { %>
      <form method="POST" action="/bg/remove" class="logo-form" onsubmit="return confirm('Voltar ao fundo padrão?');">
        <button type="submit" class="btn danger">Remover fundo</button>
      </form>
    <% } %>
  </section>

  <section class="panel">
    <h2>🖼️ Fundo da tela de login</h2>
    <p class="hint" style="margin-bottom: 12px;">Apenas o fundo da tela de login. Isso <strong>não cadastra produtos</strong>.</p>
    <% if (loginbgMsg) { %>
      <div class="alert success"><%= loginbgMsg %></div>
    <% } %>
    <% if (loginbgError) { %>
      <div class="alert error"><%= loginbgError %></div>
    <% } %>
    <% if (loginbg) { %>
      <div class="bg-preview"><img src="<%= loginbg %>" alt="Fundo do login atual"></div>
    <% } else { %>
      <p class="muted">Login sem fundo (preto). Envie uma imagem abaixo (JPG, PNG ou WEBP) para personalizar.</p>
    <% } %>
    <form method="POST" action="/loginbg" enctype="multipart/form-data" class="logo-form">
      <input type="file" name="loginbg" accept="image/jpeg,image/png,image/webp" required>
      <button type="submit" class="btn primary">Salvar fundo do login</button>
    </form>
    <% if (loginbg) { %>
      <form method="POST" action="/loginbg/remove" class="logo-form" onsubmit="return confirm('Voltar ao fundo preto do login?');">
        <button type="submit" class="btn danger">Remover fundo do login</button>
      </form>
    <% } %>
  </section>

  <section class="panel">
    <h2>Gifts gerados</h2>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Valor</th>
          <th>Status</th>
          <th>Usado por</th>
          <th>Criado em</th>
        </tr>
      </thead>
      <tbody>
        <% gifts.forEach(g => { %>
        <tr>
          <td><code><%= g.code %></code></td>
          <td>R$ <%= g.credits.toFixed(2).replace('.', ',') %></td>
          <td><span class="badge <%= g.status === 'ativo' ? 'ok' : 'warn' %>"><%= g.status %></span></td>
          <td><%= g.used_by || '—' %></td>
          <td><%= g.created_at %></td>
        </tr>
        <% }) %>
        <% if (gifts.length === 0) { %>
        <tr><td colspan="5" class="empty">Nenhum gift gerado ainda.</td></tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <section class="panel">
    <h2>Admins (acesso ao painel)</h2>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Usuário</th>
          <th>Criado em</th>
        </tr>
      </thead>
      <tbody>
        <% adminsList.forEach(a => { %>
        <tr>
          <td><%= a.id %></td>
          <td><%= a.username %></td>
          <td><%= a.created_at %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</main>
<script>
(function () {
  var pieLabels = <%- chartPie.labels %>;
  var pieValues = <%- chartPie.values %>;
  var barLabels = <%- chartBar.labels %>;
  var barValues = <%- chartBar.values %>;

  var dark = '#0f172a';
  var border = '#334155';
  var text = '#e2e8f0';
  var muted = '#94a3b8';
  var grid = '#1e293b';

  if (window.Chart) {
    new Chart(document.getElementById('pieChart'), {
      type: 'pie',
      data: {
        labels: pieLabels,
        datasets: [{
          data: pieValues,
          backgroundColor: ['#38bdf8', '#22c55e', '#f59e0b'],
          borderColor: border,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { labels: { color: text } }
        }
      }
    });

    new Chart(document.getElementById('barChart'), {
      type: 'bar',
      data: {
        labels: barLabels,
        datasets: [{
          label: 'Receita (R$)',
          data: barValues,
          backgroundColor: '#38bdf8',
          borderColor: '#0ea5e9',
          borderWidth: 1,
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { ticks: { color: muted }, grid: { color: grid } },
          y: { beginAtZero: true, ticks: { color: muted }, grid: { color: grid } }
        },
        plugins: {
          legend: { labels: { color: text } }
        }
      }
    });
  }
})();
</script>
</main>
  </div>
</div>
<script src="/app.js"></script>
</body>
</html>
