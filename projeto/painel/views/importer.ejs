<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Importar Fotos | Painel</title>
<link rel="stylesheet" href="/style.css">
</head>
<body class="dash-bg" style="--bg: url('<%= bg || '/bg.jpg' %>');">
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-brand"><% if (logo) { %><img src="<%= logo %>" alt="Logo"><% } else { %>Painel<% } %></div>
    <nav class="sidebar-nav">
      <a href="/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
        Dashboard
      </a>
      <a href="/importar" class="active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        Importar
      </a>
      <a href="/cadastrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
        Cadastrar Admin
      </a>
      <a href="/cadastrar-face">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        Cadastrar Face
      </a>
      <a href="/pagamentos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        Pagamentos
      </a>
    </nav>
    <div class="sidebar-foot">
      <a href="/logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Sair
      </a>
    </div>
  </aside>
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
  <div class="content">
    <header class="topbar">
      <button class="menu-toggle" id="menuToggle" aria-label="Abrir menu">☰</button>
      <span class="topbar-title">Importar Fotos</span>
    </header>
    <main>
  <section class="panel">
    <h2>📥 Importação automática de fotos</h2>
    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="alert success"><%= success %></div>
    <% } %>
    <p class="hint">
      Arraste fotos (ou uma pasta inteira) para a área abaixo. Cada imagem com
      rosto é cadastrada automaticamente: embedding gerado, foto enviada ao
      armazenamento persistente e exclusão da original após o cadastro.
    </p>
    <p class="hint">
      📁 <strong>Pasta = categoria</strong>: solte em <code>uploads/Praia/</code> para
      a categoria "Praia". Para metadados (nome, descrição, categoria, preço,
      tags), crie um <code>.json</code> com o mesmo nome da foto (ex.:
      <code>foto.jpg</code> + <code>foto.json</code>):
    </p>
    <pre class="code">{
  "title": "Nome do produto",
  "description": "Ficha do bico...",
  "category": "Praia",
  "price": 10,
  "tags": ["solteiro", "carro"],
  "gender": "mulher",
  "vehicle": "carro",
  "platform": "uber"
}</pre>

    <div class="dropzone" id="dropzone">
      <strong>📸 Arraste as fotos aqui</strong>
      <span class="hint">ou clique abaixo para escolher</span>
      <div class="dropzone-actions">
        <button type="button" class="btn primary small" id="btn-files">Selecionar arquivos</button>
        <button type="button" class="btn primary small" id="btn-folder">Selecionar pasta</button>
      </div>
    </div>
    <input type="file" id="input-files" accept="image/*" multiple hidden>
    <input type="file" id="input-folder" webkitdirectory multiple hidden>

    <div id="upload-log" class="hint" style="margin-top:10px;"></div>
  </section>

  <section class="panel">
    <h2>📊 Status da importação</h2>
    <div class="progress-wrap">
      <div class="progress-bar" id="progress-bar" style="width:0%"></div>
    </div>
    <div class="import-stats" id="stats">
      <span>Total: <strong id="st-total">0</strong></span>
      <span>Na fila: <strong id="st-queued">0</strong></span>
      <span>Processando: <strong id="st-processing">0</strong></span>
      <span>✅ Importadas: <strong id="st-done">0</strong></span>
      <span>⚠️ Falhas: <strong id="st-failed">0</strong></span>
      <span>🚫 Sem rosto: <strong id="st-rejected">0</strong></span>
      <span>♻️ Duplicadas: <strong id="st-duplicates">0</strong></span>
    </div>
    <p class="hint" id="status-text">Aguardando...</p>
  </section>
</main>

<script>
(function () {
  var dropzone = document.getElementById('dropzone');
  var inputFiles = document.getElementById('input-files');
  var inputFolder = document.getElementById('input-folder');
  var uploadLog = document.getElementById('upload-log');
  var pollTimer = null;

  function setDragOver(on) {
    dropzone.classList.toggle('over', !!on);
  }

  ['dragenter', 'dragover'].forEach(function (ev) {
    dropzone.addEventListener(ev, function (e) {
      e.preventDefault();
      setDragOver(true);
    });
  });
  ['dragleave', 'drop'].forEach(function (ev) {
    dropzone.addEventListener(ev, function (e) {
      e.preventDefault();
      setDragOver(false);
    });
  });
  dropzone.addEventListener('drop', function (e) {
    var files = e.dataTransfer.files;
    if (files && files.length) uploadFiles(files);
  });
  dropzone.addEventListener('click', function () { inputFiles.click(); });

  document.getElementById('btn-files').addEventListener('click', function (e) {
    e.stopPropagation();
    inputFiles.click();
  });
  document.getElementById('btn-folder').addEventListener('click', function (e) {
    e.stopPropagation();
    inputFolder.click();
  });
  inputFiles.addEventListener('change', function () {
    if (inputFiles.files.length) uploadFiles(inputFiles.files);
    inputFiles.value = '';
  });
  inputFolder.addEventListener('change', function () {
    if (inputFolder.files.length) uploadFiles(inputFolder.files);
    inputFolder.value = '';
  });

  function uploadFiles(fileList) {
    var files = Array.prototype.slice.call(fileList);
    var relpaths = files.map(function (f) { return f.webkitRelativePath || f.name; });
    var fd = new FormData();
    files.forEach(function (f) { fd.append('files', f); });
    fd.append('relpaths', JSON.stringify(relpaths));

    uploadLog.textContent = '⬆️ Enviando ' + files.length + ' arquivo(s)...';
    fetch('/api/importer/upload', { method: 'POST', body: fd })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        if (res.ok) {
          var msg = '✅ ' + res.written.length + ' arquivo(s) enviado(s). Importando...';
          if (res.skipped && res.skipped.length) msg += ' (ignorados: ' + res.skipped.join(', ') + ')';
          uploadLog.textContent = msg;
        } else {
          uploadLog.textContent = '❌ Erro no envio: ' + (res.error || 'desconhecido');
        }
      })
      .catch(function () {
        uploadLog.textContent = '❌ Falha ao enviar os arquivos.';
      });
  }

  function render(status) {
    var total = status.total || 0;
    var finished = (status.done || 0) + (status.failed || 0) + (status.rejected || 0) + (status.duplicates || 0);
    var pct = total ? Math.round((finished / total) * 100) : 0;
    document.getElementById('progress-bar').style.width = pct + '%';
    document.getElementById('st-total').textContent = total;
    document.getElementById('st-queued').textContent = status.queued;
    document.getElementById('st-processing').textContent = status.processing;
    document.getElementById('st-done').textContent = status.done;
    document.getElementById('st-failed').textContent = status.failed;
    document.getElementById('st-rejected').textContent = status.rejected;
    document.getElementById('st-duplicates').textContent = status.duplicates;

    var txt = total === 0
      ? 'Sem arquivos pendentes. Solte fotos acima para começar.'
      : 'Importados ' + status.done + ' de ' + total + ' (fila: ' + status.queued + ', processando: ' + status.processing + ')';
    document.getElementById('status-text').textContent = txt;

    if (status.idle && total > 0) {
      document.getElementById('status-text').textContent = '✅ Importação concluída. Confira os produtos em "Cadastrar Face".';
    }
  }

  function poll() {
    fetch('/api/importer/status')
      .then(function (r) { return r.json(); })
      .then(render)
      .catch(function () {});
  }

  pollTimer = setInterval(poll, 1500);
  poll();
})();
</script>
</main>
  </div>
</div>
<script src="/app.js"></script>
</body>
</html>
