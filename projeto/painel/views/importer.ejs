<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Importar Fotos | Painel</title>
<link rel="stylesheet" href="/style.css">
</head>
<body class="dash-bg" style="--bg: url('<%= bg || '/bg.jpg' %>');">
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-brand"><% if (logo) { %><img src="<%= logo %>" alt="Logo"><% } else { %>Painel<% } %></div>
    <nav class="sidebar-nav">
      <a href="/dashboard">
