# ===== Telegram =====
TELEGRAM_BOT_TOKEN=your_bot_token_here

# URL HTTPS publica do bot (usada em modo webhook na nuvem).
# Preencha apenas quando hospedado (ex.: https://seu-app.onrender.com/webhook/telegram).
# Se vazio, o bot roda em modo polling (local).
TELEGRAM_WEBHOOK_URL=

# ===== Integracao Mercado Pago (PIX) =====
# Access Token de producao do Mercado Pago (formato APP_USR-...).
# Obtido em developers.mercadolivre.com.br -> Sua aplicacao -> Credenciais.
MP_ACCESS_TOKEN=your_access_token_here

# E-mail usado como pagador no PIX (obrigatorio para gerar QR).
MP_PAYER_EMAIL=sua_conta@email.com

# (Opcional) URL de notificacao de pagamento (webhook do Mercado Pago).
# MP_NOTIFICATION_URL=https://seu-app.onrender.com/webhook/mp

# ===== PIX (chave, nome e cidade do recebedor) =====
PIX_KEY=your_pix_key_here
PIX_NAME=seu_nome
PIX_CITY=sua_cidade

# ===== Precos e recompensas =====
PRICE_FULL_PHOTO=10
REFERRAL_REWARD=10

# ===== Token do webhook de confirmacao de pagamento =====
WEBHOOK_TOKEN=defina_um_token_aleatorio

# ===== Admin do painel (opcional) =====
ADMIN_USER=admin
ADMIN_PASS=sua_senha_forte

# ===== Porta do painel =====
PANEL_PORT=3000

# ===== Armazenamento =====
# Solução simples e local: fotos em projeto/painel/faces|blurred e banco em
# projeto/database/painel.db. Sem sincronização externa (sem R2/S3).
# Atenção: em serviços com disco efêmero (Render free), o conteúdo local é
# perdido a cada deploy/reinício — commit o painel.db para preservar os dados.
